# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public canonical URL for the site. Used in SEO metadata, emails, and OG tags.
# Set to http://localhost:3000 for local dev, or your production origin in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# External 1-on-1 mentor booking profile. Nav / footer / thanks / packages
# "Book 1-on-1" CTAs use this. If unset, those links safely resolve to "#".
NEXT_PUBLIC_PATHWAY_TUTORS_PROFILE_URL=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL.
# Use the bare origin (https://<ref>.supabase.co) — no /rest/v1 path.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe for the browser; every query is subject to RLS).
# Required for SAT-planner auth (sign in / sign up / student data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — bypasses Row Level Security. Used for
# form-intake writes, /admin reads, and Stripe webhook fulfillment.
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe Checkout (one-time SAT Planner purchase)
# -----------------------------------------------------------------------------
# Prefer a restricted key (rk_) with only Checkout Session permissions. A
# standard secret key (sk_) also works. Never prefix this variable with
# NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or from the production webhook endpoint in Stripe Workbench.
STRIPE_WEBHOOK_SECRET=

# One-time Stripe Price for the SAT Study Planner product.
STRIPE_SAT_PLANNER_PRICE_ID=

# -----------------------------------------------------------------------------
# Email (Resend). Missing keys are handled gracefully — email sending is
# skipped with a warning in server logs.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
ADMIN_EMAIL=
# Optional. If unset, falls back to Resend's shared onboarding@resend.dev
# sender (fine for local dev). For production use a verified-domain sender:
#   EMAIL_FROM="Emmett Funston <hello@emmettfunston.com>"
EMAIL_FROM=

# -----------------------------------------------------------------------------
# Admin gate for /admin. Server-only; never exposed to the browser.
# Any change to this value invalidates every existing admin session.
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=
